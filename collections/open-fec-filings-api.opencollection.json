{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenFEC Candidate Filings API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Filings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List filings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.open.fec.gov/v1/filings/",
            "params": [
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to return."
              },
              {
                "name": "candidate_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "committee_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "form_type",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Reports filed with the FEC."
        }
      ]
    }
  ],
  "bundled": true
}