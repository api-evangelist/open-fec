{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenFEC Candidate Names API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Names",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Candidate name typeahead",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.open.fec.gov/v1/names/candidates/",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Candidate name typeahead"
        },
        {
          "info": {
            "name": "Committee name typeahead",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.open.fec.gov/v1/names/committees/",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Committee name typeahead"
        }
      ]
    }
  ],
  "bundled": true
}